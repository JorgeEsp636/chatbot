# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Expo / React Native)
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""

# Google Maps & Directions API
# Usa la variable de Vite que consume la app en navegador
VITE_GOOGLE_MAPS_API_KEY=""
# Compatibilidad con configuraciones Expo o scripts antiguos
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""


# URL pública de la Cloud Function chatbotCHEEMS (solo frontend, no es un secreto)
VITE_CHATBOT_API_URL=
